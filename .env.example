# 从 .env.example 复制并重命名为 .env，然后修改为你自己的设置
# 默认值匹配 config.py，但你可以覆盖任意变量。
# 参阅 README.md 获取完整列表。

# 蓝牙设备地址（必须修改）
BLE_DEVICE_ADDR=xx:xx:xx:xx:xx:xx

# BLE 特征 UUID（通常无需修改）
BLE_SERVICE_UUID=0000fff0-0000-1000-8000-00805f9b34fb
BLE_WARMUP_CHAR_UUID=0000fff3-0000-1000-8000-00805f9b34fb
BLE_VALUE_CHAR_UUID=0000fff2-0000-1000-8000-00805f9b34fb
BLE_WARMUP_SLEEP=20

# BLE 连接健壮性选项
# BLE_CONNECT_TIMEOUT：单次 connect() 超时（秒）
# BLE_CONNECT_RETRIES：单次 Reader 内连接重试次数
# BLE_CYCLE_RETRIES：整个读取-发布周期失败后的重试次数
BLE_CONNECT_TIMEOUT=10
BLE_CONNECT_RETRIES=3
BLE_CYCLE_RETRIES=2

# 校准系数（如需修正读数）
CALIB_DENSITY_MULTIPLIER=1.265
CALIB_COUNT_MULTIPLIER=2.56

# MQTT broker（必须修改）
MQTT_BROKER_HOST=x.x.x.x
MQTT_BROKER_PORT=1883
# 如果需要认证，取消注释并填写：
# MQTT_USERNAME=
# MQTT_PASSWORD=
# 若启用 TLS，设为 true
MQTT_USE_TLS=false
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_STATE_PREFIX=hmd

# 设备与传感器名称
DEVICE_NAME=AirburgEmoPlus
DEVICE_IDENTIFIER=airburg_emo_plus
SENSOR_DENSITY_NAME=PM2.5
SENSOR_COUNT_NAME=PM2.5 Count

# 运行模式：单次（<=0）或轮询间隔（秒）
READ_INTERVAL=300

# 日志级别
LOG_LEVEL=INFO